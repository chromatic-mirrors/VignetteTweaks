{
    "schemaVersion": 1,
    "id": "${id}",
    "version": "${version}",
    "name": "${name}",
    "description": "A mod that allows you to customize vignette.",
    "authors": [
        "chromatic", "awruff"
    ],
    "contact": {
        "homepage": "https://modrinth.com/project/SIRG6coC",
        "sources": "https://codeberg.org/chromatic/VignetteTweaks"
    },
    "license": "GPL-3.0",
    "icon": "assets/vignettetweaks/logo.png",
    "environment": "client",
    "entrypoints": {
        "client": [
            "org.codeberg.chromatic.vignettetweaks.VignetteTweaks"
        ],
        "modmenu": [
            "org.codeberg.chromatic.vignettetweaks.config.integration.modmenu.VignetteTweaksModMenu"
        ]
    },
    "mixins": [
        "vignettetweaks.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=0.17",
        "minecraft": "${minecraft}",
        "fabric-api": "*",
        "oneconfigv1": ">=1.0.0"
    },
    "recommends": {
        "modmenu": "*"
    },
    "conflicts": {
        "ichor": "*",
        "feather": "*"
    }
}